---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  activeNav?: string;
}

const {
  title = "Kho Tài Nguyên AI - MMO & Giải Pháp Bot Trading | Tin Tức NFT",
  description = "Cổng thông tin chuyên sâu về Tin tức AI, Hạ tầng MMO, Tín hiệu Trading SMC và Giải pháp Bot EA tự động hóa.",
  image = "/banner.jpg",
  activeNav = "Home"
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || "https://tintucnft.com");

const navItems = [
  { name: "Home", href: "/" },
  { name: "Thị Trường và AI 247", href: "/thi-truong-va-ai-247" },
  { name: "Hướng Dẫn Về AI", href: "/huong-dan-ve-ai" },
  { name: "Kho AI & Hạ Tầng MMO", href: "/kho-ai-ha-tang-mmo", isProduct: true },
  { name: "Phân Tích Crypto và Gold", href: "/phan-tich-crypto-va-gold" },
  { name: "Trading Signal VIP", href: "/trading-signal-vip", isProduct: true },
  { name: "BOT EA Trading", href: "/bot-ea-trading", isProduct: true },
  { name: "About", href: "/about" }
];
---

<!doctype html>
<html lang="vi" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={image} />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet" />

    <!-- Theme Initialization Script (Anti-FOUC) -->
    <script is:inline>
      const savedTheme = localStorage.getItem('theme');
      if (savedTheme === 'light') {
        document.documentElement.classList.remove('dark');
      } else {
        document.documentElement.classList.add('dark');
      }
    </script>

    <style is:global>
      body {
        font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
        background-color: #0b0f17;
        color: #e2e8f0;
      }
      .font-mono {
        font-family: 'JetBrains Mono', monospace;
      }
      /* Custom Scrollbar */
      ::-webkit-scrollbar {
        width: 8px;
        height: 8px;
      }
      ::-webkit-scrollbar-track {
        background: #0b0f17;
      }
      ::-webkit-scrollbar-thumb {
        background: #1e293b;
        border-radius: 4px;
      }
      ::-webkit-scrollbar-thumb:hover {
        background: #334155;
      }
    </style>

  </head>
  <body class="min-h-screen flex flex-col bg-[#0b0f17] text-slate-200 antialiased selection:bg-emerald-500 selection:text-white">

    <!-- Substack-Style Header -->
    <header class="border-b border-slate-800/80 bg-[#0b0f17]/95 backdrop-blur-md sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6">
        <!-- Top bar: Centered Publication Title & Right Substack Action Icons -->
        <div class="relative flex items-center justify-between py-3 border-b border-slate-800/60 min-h-[52px]">
          <!-- Left: Brand Tag -->
          <div class="flex items-center space-x-2">
            <a href="/" class="flex items-center space-x-2 group">
              <span class="text-[11px] font-bold tracking-wider text-emerald-400 bg-emerald-950/60 border border-emerald-800/60 px-2.5 py-0.5 rounded uppercase">
                TINTUCNFT.COM
              </span>
            </a>
          </div>

          <!-- Center: Main Title (Exact Substack Header Style) -->
          <div class="hidden md:block absolute left-1/2 -translate-x-1/2 text-center pointer-events-auto">
            <a href="/" class="text-base lg:text-lg font-bold text-white hover:text-emerald-400 transition-colors whitespace-nowrap tracking-tight">
              Kho Tài Nguyên AI - MMO & Giải Pháp Bot Trading
            </a>
          </div>

          <!-- Mobile Center (if screen small) -->
          <div class="md:hidden flex-1 px-2 text-center">
            <a href="/" class="text-xs sm:text-sm font-bold text-white truncate block">
              Kho Tài Nguyên AI - MMO
            </a>
          </div>

          <!-- Right: Action Icons, Support, Community & Theme Toggle -->
          <div class="flex items-center space-x-2 sm:space-x-3">
            <!-- Nút Nhắn tin: Hỗ trợ 24/7 (link: https://t.me/willrichus) -->
            <a
              href="https://t.me/willrichus"
              target="_blank"
              rel="noopener noreferrer"
              title="Hỗ trợ kỹ thuật 24/7 qua Telegram"
              class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-300 hover:text-emerald-400 bg-slate-800/80 hover:bg-slate-700/80 border border-slate-700/80 px-2.5 sm:px-3 py-1.5 rounded-full transition-all"
            >
              <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
              </svg>
              <span class="whitespace-nowrap">Hỗ trợ 24/7</span>
            </a>

            <!-- Notification Bell Icon (giữ nguyên, gắn với Trading Signal VIP) -->
            <a
              href="/trading-signal-vip"
              title="Tín hiệu Live Realtime MT5"
              class="relative text-slate-400 hover:text-emerald-400 transition-colors p-1.5 rounded-full hover:bg-slate-800/70"
            >
              <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
              </svg>
              <span class="absolute top-1 right-1 w-2 h-2 bg-emerald-500 rounded-full animate-ping"></span>
              <span class="absolute top-1 right-1 w-2 h-2 bg-emerald-500 rounded-full"></span>
            </a>

            <!-- Nút Cộng đồng Telegram (đổi từ Dashboard, gắn link: https://t.me/channelmcg) -->
            <a
              href="https://t.me/channelmcg"
              target="_blank"
              rel="noopener noreferrer"
              title="Tham gia Kênh Telegram Tín Hiệu & MMO"
              class="inline-flex items-center gap-1.5 text-xs font-bold text-slate-950 bg-emerald-500 hover:bg-emerald-400 px-3 sm:px-3.5 py-1.5 rounded-full transition-all duration-200 shadow-sm shadow-emerald-500/20 whitespace-nowrap"
            >
              <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm5.894 8.221l-1.97 9.28c-.145.658-.537.818-1.084.508l-3-2.21-1.446 1.394c-.16.16-.295.295-.605.295l.213-3.053 5.56-5.023c.242-.213-.054-.333-.373-.121l-6.871 4.326-2.962-.924c-.643-.204-.657-.643.136-.953l11.57-4.461c.537-.194 1.006.131.832.942z"/>
              </svg>
              <span>Cộng đồng Telegram</span>
            </a>

            <!-- Nút Chọn Giao Diện Sáng / Tối (Theme Toggle) Ở Góc Phải -->
            <button
              id="themeToggleBtn"
              type="button"
              title="Chuyển đổi giao diện Sáng / Tối"
              class="text-slate-400 hover:text-amber-400 bg-slate-800/80 hover:bg-slate-700/80 border border-slate-700/80 p-1.5 sm:p-2 rounded-full transition-all flex items-center justify-center cursor-pointer shadow-sm"
              aria-label="Toggle theme"
            >
              <!-- Sun icon (khi dark mode) -->
              <svg id="themeSunIcon" class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="5"></circle>
                <line x1="12" y1="1" x2="12" y2="3"></line>
                <line x1="12" y1="21" x2="12" y2="23"></line>
                <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
                <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
                <line x1="1" y1="12" x2="3" y2="12"></line>
                <line x1="21" y1="12" x2="23" y2="12"></line>
                <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
                <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
              </svg>
              <!-- Moon icon (khi light mode) -->
              <svg id="themeMoonIcon" class="w-4 h-4 text-slate-700 hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
              </svg>
            </button>
          </div>
        </div>

        <!-- Main Navigation Bar (Exact Substack Line Tabs) -->
        <nav class="flex items-center overflow-x-auto scrollbar-none text-xs sm:text-sm font-medium">
          <div class="flex items-center space-x-6 sm:space-x-8 whitespace-nowrap pt-1">
            {navItems.map((item) => {
              const isActive = activeNav === item.name;
              return (
                <a
                  href={item.href}
                  class={`relative pb-2.5 pt-1.5 transition-all font-medium ${
                    isActive
                      ? "text-white font-bold border-b-2 border-emerald-400 -mb-[1px]"
                      : item.isProduct
                      ? "text-amber-300 hover:text-amber-200 border-b-2 border-transparent hover:border-amber-400/50 -mb-[1px]"
                      : "text-slate-400 hover:text-slate-100 border-b-2 border-transparent hover:border-slate-500 -mb-[1px]"
                  }`}
                >
                  {item.isProduct && <span class="text-[11px] mr-1 text-amber-400">⚡</span>}
                  {item.name}
                </a>
              );
            })}
          </div>
        </nav>
      </div>
    </header>

    <!-- Main Content Slot -->
    <main class="flex-grow">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-slate-800 bg-[#080d14] text-slate-400 py-12 mt-16 text-xs sm:text-sm">
      <div class="max-w-7xl mx-auto px-4 sm:px-6">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-8">
          <div class="space-y-3">
            <div class="text-white font-bold text-base">TINTUCNFT.COM</div>
            <p class="text-slate-400 text-xs leading-relaxed">
              Hệ sinh thái thông tin tài chính số, phân tích kỹ thuật SMC, hạ tầng MMO tự động hóa và giải pháp Bot EA MT5 chuyên nghiệp.
            </p>
          </div>
          <div>
            <h4 class="text-white font-semibold mb-3">Chuyên Mục Nội Dung</h4>
            <ul class="space-y-2 text-xs">
              <li><a href="/thi-truong-va-ai-247" class="hover:text-emerald-400 transition-colors">Thị Trường và AI 247</a></li>
              <li><a href="/huong-dan-ve-ai" class="hover:text-emerald-400 transition-colors">Hướng Dẫn Về AI</a></li>
              <li><a href="/phan-tich-crypto-va-gold" class="hover:text-emerald-400 transition-colors">Phân Tích Crypto và Gold</a></li>
            </ul>
          </div>
          <div>
            <h4 class="text-white font-semibold mb-3">Sản Phẩm & Dịch Vụ</h4>
            <ul class="space-y-2 text-xs">
              <li><a href="/kho-ai-ha-tang-mmo" class="hover:text-amber-400 transition-colors">Kho AI & Hạ Tầng MMO</a></li>
              <li><a href="/trading-signal-vip" class="hover:text-amber-400 transition-colors">Trading Signal VIP</a></li>
              <li><a href="/bot-ea-trading" class="hover:text-amber-400 transition-colors">BOT EA Trading MT5</a></li>
            </ul>
          </div>
          <div>
            <h4 class="text-white font-semibold mb-3">Liên Hệ & Cộng Đồng</h4>
            <p class="text-xs text-slate-400 mb-3">Tham gia kênh Telegram để cập nhật tin tức & tín hiệu realtime.</p>
            <div class="flex flex-col gap-2">
              <a href="https://t.me/channelmcg" target="_blank" class="text-emerald-400 hover:underline">✈️ Telegram Channel</a>
              <a href="https://t.me/willrichus" target="_blank" class="text-emerald-400 hover:underline">💬 Hỗ Trợ Kỹ Thuật (@willrichus)</a>
            </div>
          </div>
        </div>
        <div class="pt-8 border-t border-slate-800 text-center text-xs text-slate-400">
          <p>© 2026 TINTUCNFT.COM - All Rights Reserved. Tự động hóa Jamstack với Cloudflare Pages & Notion CMS.</p>
        </div>
      </div>
    </footer>

    <!-- Floating Theme Toggle at bottom right for extra convenience -->
    <button
      id="floatingThemeBtn"
      type="button"
      title="Chuyển đổi giao diện Sáng / Tối"
      class="fixed bottom-6 right-6 z-40 bg-slate-900/90 dark:bg-slate-800/90 hover:bg-emerald-500 text-amber-400 dark:text-amber-300 hover:text-slate-950 p-3 rounded-full shadow-2xl border border-slate-700/80 hover:border-emerald-400 transition-all duration-200 cursor-pointer flex items-center justify-center backdrop-blur-md"
      aria-label="Toggle theme mode"
    >
      <svg class="w-5 h-5 theme-sun-icon" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <circle cx="12" cy="12" r="5"></circle>
        <line x1="12" y1="1" x2="12" y2="3"></line>
        <line x1="12" y1="21" x2="12" y2="23"></line>
        <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
        <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
        <line x1="1" y1="12" x2="3" y2="12"></line>
        <line x1="21" y1="12" x2="23" y2="12"></line>
        <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
        <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
      </svg>
      <svg class="w-5 h-5 theme-moon-icon hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
      </svg>
    </button>

    <!-- Theme Toggle Handler Script -->
    <script is:inline>
      function syncThemeUI() {
        const isDark = document.documentElement.classList.contains('dark');
        const sunIcons = document.querySelectorAll('#themeSunIcon, .theme-sun-icon');
        const moonIcons = document.querySelectorAll('#themeMoonIcon, .theme-moon-icon');

        sunIcons.forEach(icon => {
          if (isDark) icon.classList.remove('hidden');
          else icon.classList.add('hidden');
        });

        moonIcons.forEach(icon => {
          if (!isDark) icon.classList.remove('hidden');
          else icon.classList.add('hidden');
        });
      }

      function toggleTheme() {
        const isDark = document.documentElement.classList.contains('dark');
        if (isDark) {
          document.documentElement.classList.remove('dark');
          localStorage.setItem('theme', 'light');
        } else {
          document.documentElement.classList.add('dark');
          localStorage.setItem('theme', 'dark');
        }
        syncThemeUI();
      }

      document.addEventListener('DOMContentLoaded', () => {
        syncThemeUI();
        const btns = document.querySelectorAll('#themeToggleBtn, #floatingThemeBtn');
        btns.forEach(btn => {
          btn.addEventListener('click', toggleTheme);
        });
      });
    </script>
  </body>
</html>
