---
import Layout from '../layouts/Layout.astro';
import { getPublishedArticles } from '../lib/notion.js';

const category = 'Hướng Dẫn Về AI';
const articles = await getPublishedArticles(category);
---

<Layout title="Hướng Dẫn Về AI & Hạ Tầng MMO | Tin Tức NFT" activeNav="Hướng Dẫn Về AI" description="Cẩm nang hướng dẫn ứng dụng AI, xây dựng hạ tầng MMO, thiết lập Proxy VPS và tự động hóa quy trình nuôi tài khoản không lo checkpoint.">

  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-12">
    <!-- Header Chuyên Mục -->
    <div class="mb-10 text-center max-w-3xl mx-auto">
      <span class="text-xs font-bold uppercase tracking-wider text-emerald-400 bg-emerald-950/60 border border-emerald-800/60 px-3 py-1 rounded-full">Thực Chiến Kiếm Tiền</span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-white mt-4 mb-3">Hướng Dẫn Về AI & Hạ Tầng MMO</h1>
      <p class="text-sm sm:text-base text-slate-400">
        Đúc kết kinh nghiệm thực tế: Tự động hóa các tác vụ lặp đi lặp lại bằng AI, cấu hình Proxy/VPS nuôi tài khoản đa luồng an toàn và tối ưu chi phí.
      </p>
    </div>

    <!-- BANNER QUẢNG CÁO NỔI BẬT: KHO 84+ CÔNG CỤ AI & BOT TELEGRAM -->
    <div class="mb-12 p-6 sm:p-8 rounded-3xl bg-gradient-to-br from-emerald-950/80 via-slate-900 to-slate-950 border-2 border-emerald-500/40 shadow-2xl relative overflow-hidden group">
      <div class="absolute -right-10 -bottom-10 w-72 h-72 bg-emerald-500/10 rounded-full blur-3xl group-hover:bg-emerald-500/25 transition-all duration-700 pointer-events-none"></div>

      <div class="relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-6 items-center">
        <!-- Thông tin banner -->
        <div class="lg:col-span-8 space-y-4">
          <div class="flex flex-wrap items-center gap-2.5">
            <span class="px-3 py-1 rounded-full text-xs font-extrabold uppercase tracking-wider bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 inline-flex items-center gap-1.5 shadow-sm">
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
              ⚡ KHO 84+ CÔNG CỤ AI & HẠ TẦNG MMO
            </span>
            <span class="px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-slate-800 text-yellow-300 border border-yellow-500/30">
              Tiết Kiệm Đến 80% Chi Phí
            </span>
            <span class="px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-slate-800 text-sky-400 border border-sky-500/30">
              Bot Trả Tài Khoản Sau 3 Giây
            </span>
          </div>

          <h2 class="text-xl sm:text-2xl lg:text-3xl font-extrabold text-white leading-snug">
            Cung Cấp Tài Khoản AI & Hạ Tầng MMO Bản Quyền Tự Động 24/7
          </h2>

          <p class="text-xs sm:text-sm text-slate-300 leading-relaxed max-w-2xl">
            Sở hữu ngay tài khoản bản quyền riêng biệt: ChatGPT Plus, Claude Pro, Midjourney, Runway Gen-3, Cursor Pro, GPM-Login, Proxy IPv4 tĩnh sạch nuôi nick an toàn. Mua trực tiếp qua Telegram Bot, tự động kích hoạt tức thì.
          </p>

          <div class="flex flex-wrap items-center gap-4 text-xs text-slate-400 pt-1">
            <span class="flex items-center gap-1.5"><i class="fa-solid fa-bolt text-emerald-400"></i> Bot tự động 24/7 không cần chờ</span>
            <span class="flex items-center gap-1.5"><i class="fa-solid fa-shield text-emerald-400"></i> Bảo hành 1 đổi 1 suốt thời gian sử dụng</span>
            <span class="flex items-center gap-1.5"><i class="fa-solid fa-key text-emerald-400"></i> Tặng kèm trọn bộ Prompt & Skill AI</span>
          </div>
        </div>

        <!-- Các nút CTA chuyển đổi cao -->
        <div class="lg:col-span-4 flex flex-col gap-3">
          <a
            href="https://t.me/chatgpsplusbot"
            target="_blank"
            class="w-full py-4 px-6 rounded-2xl bg-gradient-to-r from-emerald-500 to-green-500 hover:from-emerald-400 hover:to-green-400 text-slate-950 font-extrabold text-xs sm:text-sm uppercase tracking-wider transition-all transform hover:scale-[1.02] active:scale-[0.98] flex items-center justify-center gap-2 shadow-xl shadow-emerald-950/60"
          >
            <i class="fa-brands fa-telegram text-base"></i>
            <span>MUA TỰ ĐỘNG QUA TELEGRAM BOT (@chatgpsplusbot)</span>
          </a>

          <a
            href="/kho-ai-ha-tang-mmo"
            class="w-full py-3 px-5 rounded-xl bg-slate-800/90 hover:bg-slate-700 text-slate-200 border border-slate-700 font-bold text-xs text-center transition-colors flex items-center justify-center gap-2"
          >
            <span>Xem Danh Sách 84+ Công Cụ Kho MMO →</span>
          </a>

          <p class="text-[11px] text-center text-slate-400">
            Hỗ trợ tư vấn sỉ / cài đặt: <a href="https://t.me/willrichus" target="_blank" class="text-emerald-400 font-semibold hover:underline">@willrichus</a>
          </p>
        </div>
      </div>
    </div>

    <!-- DANH SÁCH BÀI VIẾT (CÓ ẢNH THUMBNAIL 16:9 CHUẨN TRANG HOME) -->
    {articles.length === 0 ? (
      <div class="text-center py-16 bg-slate-900/50 rounded-2xl border border-slate-800">
        <p class="text-slate-400">Chưa có bài viết nào trong chuyên mục này. Hãy thêm bài mới trên Notion!</p>
      </div>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {articles.map((art) => (
          <article class="bg-slate-900/80 border border-slate-800 rounded-2xl overflow-hidden hover:border-emerald-500/50 transition-all flex flex-col justify-between group shadow-xl">
            <div>
              <!-- ẢNH THUMBNAIL 16:9 -->
              <a href={`/p/${art.slug}`} class="block aspect-video overflow-hidden bg-slate-950 border-b border-slate-800">
                <img
                  src={art.featuredImage}
                  alt={art.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                  loading="lazy"
                />
              </a>

              <div class="p-6">
                <div class="flex items-center justify-between text-xs text-slate-400 mb-3">
                  <span class="text-emerald-400 font-semibold">{art.category}</span>
                  <span>{art.date}</span>
                </div>
                <h2 class="text-lg font-bold text-white hover:text-emerald-300 transition-colors mb-3 leading-snug">
                  <a href={`/p/${art.slug}`}>{art.title}</a>
                </h2>
                <p class="text-xs sm:text-sm text-slate-400 line-clamp-3 mb-4 leading-relaxed">
                  {art.summary}
                </p>
              </div>
            </div>

            <div class="px-6 pb-6 pt-2 border-t border-slate-800/60">
              <a href={`/p/${art.slug}`} class="text-xs font-semibold text-emerald-400 hover:text-emerald-300 flex items-center gap-1.5">
                Đọc toàn bộ bài viết →
              </a>
            </div>
          </article>
        ))}
      </div>
    )}
  </section>

</Layout>
