---
import Layout from '../layouts/Layout.astro';
import { getPublishedArticles } from '../lib/notion.js';

const category = 'Hướng Dẫn Về AI';
const articles = await getPublishedArticles(category);
---

<Layout title="Hướng Dẫn Về AI & MMO | Tin Tức NFT" activeNav="Hướng Dẫn Về AI" description="Cẩm nang hướng dẫn ứng dụng AI, xây dựng hạ tầng MMO, thiết lập Proxy VPS và tự động hóa quy trình nuôi tài khoản không lo checkpoint.">

  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-12">
    <div class="mb-10 text-center max-w-3xl mx-auto">
      <span class="text-xs font-bold uppercase tracking-wider text-green-400 bg-green-950/60 border border-green-800/60 px-3 py-1 rounded-full">Thực Chiến Kiếm Tiền</span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-white mt-4 mb-3">Hướng Dẫn Về AI & MMO</h1>
      <p class="text-sm sm:text-base text-slate-400">
        Đúc kết kinh nghiệm thực tế: Tự động hóa các tác vụ lặp đi lặp lại bằng AI, cấu hình Proxy/VPS nuôi tài khoản đa luồng an toàn.
      </p>
    </div>

    <!-- Lead Magnet Sticky Box -->
    <div class="mb-12 p-6 bg-gradient-to-r from-emerald-950/60 to-slate-900 border border-emerald-800/80 rounded-2xl flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="space-y-1">
        <div class="text-xs font-bold uppercase text-emerald-400 tracking-wider">QUÀ TẶNG THÀNH VIÊN</div>
        <h3 class="text-lg font-bold text-white">🎁 Tặng Key GPM-Login & Gói Data Skill AI Chuyên Biệt</h3>
        <p class="text-xs sm:text-sm text-slate-400">Trọn bộ tài nguyên nuôi 100 nick X/TikTok và kỹ năng AI tự động hóa bán hàng.</p>
      </div>
      <a href="/kho-ai-ha-tang-mmo" class="px-6 py-3 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold text-xs uppercase tracking-wider transition-colors whitespace-nowrap shadow-lg shadow-emerald-950/50">
        Xem Ngay Tại Kho MMO →
      </a>
    </div>

    {articles.length === 0 ? (
      <div class="text-center py-16 bg-slate-900/50 rounded-2xl border border-slate-800">
        <p class="text-slate-400">Chưa có bài viết nào trong chuyên mục này. Hãy thêm bài mới trên Notion!</p>
      </div>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {articles.map((art) => (
          <article class="bg-slate-900/80 border border-slate-800 rounded-2xl p-6 hover:border-emerald-500/50 transition-all flex flex-col justify-between hover:shadow-xl">
            <div>
              <div class="flex items-center justify-between text-xs text-slate-400 mb-3">
                <span class="text-emerald-400 font-semibold">{art.category}</span>
                <span>{art.date}</span>
              </div>
              <h2 class="text-lg font-bold text-white hover:text-emerald-300 transition-colors mb-3 leading-snug">
                <a href={`/p/${art.slug}`}>{art.title}</a>
              </h2>
              <p class="text-xs sm:text-sm text-slate-400 line-clamp-3 mb-6 leading-relaxed">
                {art.summary}
              </p>
            </div>
            <a href={`/p/${art.slug}`} class="text-xs font-semibold text-emerald-400 hover:text-emerald-300 flex items-center gap-1.5">
              Đọc hướng dẫn chi tiết →
            </a>
          </article>
        ))}
      </div>
    )}
  </section>

</Layout>
