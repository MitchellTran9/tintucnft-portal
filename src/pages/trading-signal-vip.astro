---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Trading Signal VIP | Tin Tức NFT" activeNav="Trading Signal VIP" description="Kênh tín hiệu giao dịch Vàng XAUUSD và Crypto độc quyền chuẩn SMC, Order Block, kết nối Webhook MT5 trực tiếp.">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <div class="trading-signal-wrapper overflow-hidden">
    <!-- Hero Section (FinLive Style) -->
    <section class="relative pt-14 pb-20 overflow-hidden bg-grid">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
            <!-- Badge -->
            <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-gold/10 border border-gold/20 text-gold-400 text-xs sm:text-sm font-bold mb-6">
                <span class="w-2 h-2 rounded-full bg-gold-400 animate-ping"></span>
                <span>HỆ THỐNG TÍN HIỆU GIAO DỊCH VÀNG & CRYPTO CHUẨN XÁC 2026</span>
            </div>

            <!-- Main Title -->
            <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight max-w-5xl mx-auto leading-tight sm:leading-tight lg:leading-tight mb-6">
                Chấm Dứt Mọi Cảm Xúc FOMO: <br>
                <span class="text-gradient-gold">Đánh Cùng Cá Mập Với Tín Hiệu R:R 1:2.8+</span>
            </h1>

            <p class="text-slate-400 text-base sm:text-lg max-w-3xl mx-auto mb-10 leading-relaxed font-normal">
                Kênh tín hiệu thực chiến chuyên sâu cho <span class="text-slate-100 font-semibold">Vàng (XAUUSD) & Bitcoin/Altcoin</span>. Không gồng lỗ, không Martingale, minh bạch 100% từng lệnh Entry, SL, TP theo phương pháp Smart Money Concept (SMC).
            </p>

            <!-- Buttons -->
            <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-14">
                <a href="#vip-flow" class="w-full sm:w-auto px-8 py-4 rounded-xl font-extrabold text-base bg-gradient-to-r from-gold-500 to-amber-500 hover:from-gold-400 hover:to-amber-400 text-dark-950 shadow-xl shadow-gold-500/30 transition-all flex items-center justify-center gap-3 group">
                    <i class="fa-solid fa-crown text-lg"></i>
                    <span>NHẬN TÍN HIỆU VIP MIỄN PHÍ QUA SÀN ĐỐI TÁC</span>
                </a>
                <a href="https://t.me/channelmcg" target="_blank" class="w-full sm:w-auto px-8 py-4 rounded-xl font-bold text-base bg-dark-700/80 hover:bg-dark-600 text-slate-200 border border-white/10 hover:border-white/20 transition-all flex items-center justify-center gap-2">
                    <i class="fa-brands fa-telegram text-sky-400 text-lg"></i>
                    <span>Tham Gia Kênh Telegram Free</span>
                </a>
            </div>

            <!-- 4 Institutional Metrics (Data Proof - Giống FinLive) -->
            <div id="stats" class="grid grid-cols-2 lg:grid-cols-4 gap-4 max-w-5xl mx-auto text-left">
                <div class="glass-card p-5 rounded-2xl relative overflow-hidden">
                    <div class="text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1 flex items-center justify-between">
                        <span>Win Rate Thực Tế</span>
                        <i class="fa-solid fa-bullseye text-emerald-400"></i>
                    </div>
                    <div class="text-3xl sm:text-4xl font-extrabold text-emerald-400 mono">78.5%</div>
                    <div class="text-[11px] text-slate-400 mt-1">Thống kê trên 732 lệnh đóng</div>
