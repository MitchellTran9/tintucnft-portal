                </div>

                <div class="glass-card p-5 rounded-2xl relative overflow-hidden">
                    <div class="text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1 flex items-center justify-between">
                        <span>Tần Suất Tín Hiệu</span>
                        <i class="fa-solid fa-bell text-indigo-400"></i>
                    </div>
                    <div class="text-3xl sm:text-4xl font-extrabold text-indigo-400 mono">3 - 6</div>
                    <div class="text-[11px] text-slate-400 mt-1">Lệnh chọn lọc cao cấp / ngày</div>
                </div>
            </div>
        </div>
    </section>

    <!-- Section: 2 Khung Tín Hiệu Riêng Biệt (Vàng MT5 & 5 Coin Telegram) -->
    <section id="signals" class="py-16 bg-dark-900 border-t border-white/5">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
