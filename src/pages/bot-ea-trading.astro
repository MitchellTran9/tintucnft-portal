        const initialDepositSummary = document.getElementById('initialDepositSummary');
        const netProfitDisplay = document.getElementById('netProfitDisplay');
        const roiDisplay = document.getElementById('roiDisplay');

        function updateCompound() {
            const P = parseFloat(depositSlider.value);
            const r = parseFloat(rateSlider.value) / 100;
            const n = parseInt(monthsSlider.value);

            depositDisplay.innerText = '$' + P.toLocaleString('en-US');
            rateDisplay.innerText = (r * 100).toFixed(1) + '% / tháng';
            monthsDisplay.innerText = n + ' Tháng ' + (n === 12 ? '(1 Năm)' : (n === 24 ? '(2 Năm)' : ''));

            // Compound formula: A = P * (1 + r)^n
            const A = P * Math.pow(1 + r, n);
            const profit = A - P;
            const roi = (profit / P) * 100;

            totalBalanceDisplay.innerText = '$' + A.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2});
            initialDepositSummary.innerText = '$' + P.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2});
            netProfitDisplay.innerText = '+$' + profit.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2});
            roiDisplay.innerText = '+' + roi.toFixed(1) + '%';
        }

        depositSlider.addEventListener('input', updateCompound);
        rateSlider.addEventListener('input', updateCompound);
        monthsSlider.addEventListener('input', updateCompound);
        updateCompound();

