---
import Layout from '../layouts/Layout.astro';
import { getPublishedArticles } from '../lib/notion.js';

const category = 'Thị Trường và AI 247';
const articles = await getPublishedArticles(category);
---

<Layout title="Thị Trường và AI 247 | Tin Tức NFT" activeNav="Thị Trường và AI 247" description="Bản tin tổng hợp biến động thị trường tài chính, kinh tế vĩ mô, giá Vàng XAUUSD, Bitcoin và đột phá AI 24/7.">

  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-12">
    <div class="mb-10 text-center max-w-3xl mx-auto">
      <span class="text-xs font-bold uppercase tracking-wider text-blue-400 bg-blue-950/60 border border-blue-800/60 px-3 py-1 rounded-full">Bản Tin Thời Sự 24/7</span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-white mt-4 mb-3">Thị Trường và AI 247</h1>
      <p class="text-sm sm:text-base text-slate-400">
        Theo dõi nhịp đập tài chính toàn cầu: Các tin tức ảnh hưởng mạnh tới đường đi của Vàng, Crypto và những công cụ AI mới nhất làm thay đổi cuộc chơi.
      </p>
    </div>

    {articles.length === 0 ? (
      <div class="text-center py-16 bg-slate-900/50 rounded-2xl border border-slate-800">
        <p class="text-slate-400">Chưa có bài viết nào trong chuyên mục này. Hãy thêm bài mới trên Notion!</p>
      </div>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {articles.map((art) => (
          <article class="bg-slate-900/80 border border-slate-800 rounded-2xl p-6 hover:border-blue-500/50 transition-all flex flex-col justify-between hover:shadow-xl">
            <div>
              <div class="flex items-center justify-between text-xs text-slate-400 mb-3">
                <span class="text-blue-400 font-semibold">{art.category}</span>
                <span>{art.date}</span>
              </div>
              <h2 class="text-lg font-bold text-white hover:text-blue-300 transition-colors mb-3 leading-snug">
                <a href={`/p/${art.slug}`}>{art.title}</a>
              </h2>
              <p class="text-xs sm:text-sm text-slate-400 line-clamp-3 mb-6 leading-relaxed">
                {art.summary}
              </p>
            </div>
            <a href={`/p/${art.slug}`} class="text-xs font-semibold text-blue-400 hover:text-blue-300 flex items-center gap-1.5">
              Đọc toàn bộ bài viết →
            </a>
          </article>
        ))}
      </div>
    )}
  </section>

</Layout>
