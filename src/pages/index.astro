---
import Layout from '../layouts/Layout.astro';
import { getPublishedArticles } from '../lib/notion.js';

const allArticles = await getPublishedArticles();

// 1. Tin tiêu điểm (Hero lead - bài viết mới nhất)
const heroArticle = allArticles[0] || null;

// 2. Hàng 3 cột tin phụ (Sub-features - 3 bài tiếp theo)
const subFeatures = allArticles.slice(1, 4);

// 3. Phân luồng theo 3 chuyên mục chính
const newsArticles = allArticles.filter(a => a.category === 'Thị Trường và AI 247').slice(0, 4);
const guideArticles = allArticles.filter(a => a.category === 'Hướng Dẫn Về AI').slice(0, 4);
const analysisArticles = allArticles.filter(a => a.category === 'Phân Tích Crypto và Gold').slice(0, 4);
---

<Layout title="Kho Tài Nguyên AI - MMO & Giải Pháp Bot Trading | Tin Tức NFT" activeNav="Home">

  <!-- ========================================================
       PHẦN 1: BÁO CHÍ ĐẶC BIỆT (2/3 TIN TIÊU ĐIỂM + 1/3 SIDEBAR PHỄU)
       Theo đúng layout wireframe toà soạn báo lớn
       ======================================================== -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 pt-8 pb-12">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">

      <!-- CỘT TRÁI (2/3 KHÔNG GIAN - lg:col-span-8) -->
      <div class="lg:col-span-8 space-y-8">

        <!-- TIN TIÊU ĐIỂM (HERO LEAD - 2/3 KHÔNG GIAN) -->
        {heroArticle ? (
          <article class="p-6 sm:p-7 rounded-3xl bg-slate-900/80 border border-slate-800 hover:border-emerald-500/40 transition-all duration-300 shadow-2xl group">
            <div class="flex items-center gap-3 mb-5">
              <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-extrabold uppercase tracking-wider bg-rose-500/15 text-rose-400 border border-rose-500/30">
                <span class="w-2 h-2 rounded-full bg-rose-500 animate-ping"></span>
                TIN TIÊU ĐIỂM HÔM NAY
              </span>
              <span class="text-xs font-bold text-emerald-400 bg-emerald-950/60 border border-emerald-800/60 px-3 py-1 rounded-full">
                {heroArticle.category}
              </span>
            </div>

            <!-- Khung 2 cột: Trái Ảnh Lớn 16:9 - Phải Tiêu đề & Sáp-pô -->
            <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-center">
              <!-- Ảnh Lớn 16:9 (Ảnh AI Render sắc nét) -->
              <div class="md:col-span-7 overflow-hidden rounded-2xl aspect-video bg-slate-950 border border-slate-800 shadow-inner">
                <a href={`/p/${heroArticle.slug}`} class="block w-full h-full relative group">
                  <img
                    src={heroArticle.featuredImage}
                    alt={heroArticle.title}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    loading="eager"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-slate-950/40 to-transparent"></div>
                </a>
              </div>

              <!-- Tiêu đề, Sáp-pô (Lead) dẫn dắt & Timestamp -->
              <div class="md:col-span-5 flex flex-col justify-between h-full">
                <div>
                  <h2 class="text-xl sm:text-2xl font-extrabold text-white group-hover:text-emerald-400 transition-colors leading-snug mb-3">
                    <a href={`/p/${heroArticle.slug}`}>{heroArticle.title}</a>
                  </h2>
                  <p class="text-xs sm:text-sm text-slate-300 line-clamp-4 leading-relaxed mb-4 font-normal">
                    {heroArticle.summary}
                  </p>
                </div>

                <div class="pt-3 border-t border-slate-800 flex items-center justify-between text-xs text-slate-400">
                  <span class="flex items-center gap-1.5 font-medium">
                    🕒 {heroArticle.date || "Vừa cập nhật"}
                  </span>
                  <a href={`/p/${heroArticle.slug}`} class="text-emerald-400 font-bold hover:underline inline-flex items-center gap-1">
                    Đọc toàn bài →
                  </a>
                </div>
              </div>
            </div>
          </article>
        ) : (
          <div class="p-8 text-center bg-slate-900 rounded-3xl border border-slate-800 text-slate-400">
            Đang tải dữ liệu bản tin mới nhất từ Notion...
          </div>
        )}

        <!-- HÀNG 3 CỘT TIN PHỤ (SUB-FEATURES) -->
        <div>
          <div class="flex items-center justify-between mb-4 pb-2 border-b border-slate-800">
            <h3 class="text-xs sm:text-sm font-extrabold text-slate-200 uppercase tracking-wider flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
              <span>BẢN TIN NỔI BẬT KHÁC (SUB-FEATURES)</span>
            </h3>
            <span class="text-xs text-slate-400">Cập nhật tự động 24/7</span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
            {subFeatures.map((art) => (
              <article class="p-4 rounded-2xl bg-slate-900/60 border border-slate-800/80 hover:border-emerald-500/40 transition-all flex flex-col justify-between group shadow-lg">
                <div>
                  <!-- Ảnh Thumb 16:9 -->
                  <a href={`/p/${art.slug}`} class="block overflow-hidden rounded-xl aspect-video bg-slate-950 mb-3 border border-slate-800/80">
                    <img
                      src={art.featuredImage}
                      alt={art.title}
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                      loading="lazy"
                    />
                  </a>
                  <div class="text-[11px] font-semibold text-emerald-400 mb-1.5 flex items-center justify-between">
                    <span class="truncate max-w-[130px]">{art.category}</span>
                    <span class="text-slate-500 text-[10px]">{art.date}</span>
                  </div>
                  <h4 class="text-sm font-bold text-white group-hover:text-emerald-400 transition-colors line-clamp-2 leading-snug mb-2">
                    <a href={`/p/${art.slug}`}>{art.title}</a>
                  </h4>
                  <p class="text-xs text-slate-400 line-clamp-2 leading-relaxed">
                    {art.summary}
                  </p>
                </div>
                <div class="pt-3 mt-3 border-t border-slate-800/60 flex items-center justify-between">
                  <a href={`/p/${art.slug}`} class="text-xs font-bold text-emerald-400 group-hover:underline inline-flex items-center gap-1">
                    Xem tiếp →
                  </a>
                  <span class="text-[10px] text-slate-400">5 phút đọc</span>
                </div>
              </article>
            ))}
          </div>
        </div>

      </div>

      <!-- CỘT PHẢI: SIDEBAR PHỄU (1/3 KHÔNG GIAN - lg:col-span-4) -->
      <!-- Chuyển đổi phễu cực kỳ tự nhiên như báo lớn, có sẵn link sản phẩm website + Telegram Bot -->
      <aside class="lg:col-span-4 space-y-6">

        <!-- BANNER 1: KHO 84 CÔNG CỤ AI & HẠ TẦNG MMO -->
        <div class="p-6 rounded-3xl bg-gradient-to-br from-emerald-950/70 via-slate-900 to-slate-950 border border-emerald-500/30 shadow-xl relative overflow-hidden group">
          <div class="flex items-center justify-between mb-4">
            <span class="px-3 py-1 rounded-full text-[11px] font-extrabold uppercase tracking-wider bg-emerald-500/20 text-emerald-400 border border-emerald-500/30">
              ⚡ KHO SẢN PHẨM SỐ 1
            </span>
            <span class="text-xs text-emerald-400 font-bold">84+ Tool AI</span>
          </div>

          <h3 class="text-xl font-extrabold text-white mb-2 group-hover:text-emerald-300 transition-colors">
            Kho 84 Công Cụ AI & Hạ Tầng MMO 2026
          </h3>
          <p class="text-xs text-slate-300 leading-relaxed mb-5">
            Cung cấp Proxy IPv4 tĩnh sạch, VPS chạy đa luồng & 84 tài khoản AI bản quyền giá sỉ (ChatGPT Plus, Claude Pro, Cursor AI, Kling, Midjourney...).
          </p>

          <div class="space-y-2.5">
            <!-- Nút mua ngay qua Bot Telegram -->
            <a
              href="https://t.me/chatgpsplusbot"
              target="_blank"
              class="w-full py-3.5 px-4 rounded-xl bg-gradient-to-r from-emerald-500 to-teal-500 hover:from-emerald-400 hover:to-teal-400 text-slate-950 font-extrabold text-xs uppercase tracking-wider transition-all flex items-center justify-center gap-2 shadow-lg shadow-emerald-950/50"
            >
              <i class="fa-solid fa-robot text-sm"></i>
              <span>MUA NGAY QUA TELEGRAM BOT</span>
            </a>

            <!-- Nút xem chi tiết sản phẩm trên website -->
            <a
              href="/kho-ai-ha-tang-mmo"
              class="w-full py-2.5 px-4 rounded-xl bg-slate-800/80 hover:bg-slate-700 text-slate-200 border border-slate-700 font-bold text-xs text-center transition-colors block"
            >
              Xem Toàn Bộ Sản Phẩm Trên Website →
            </a>
          </div>
        </div>

        <!-- BANNER 2: BOT EA TRADING MT5 (NO PAIN NO GAIN 1 & 2) -->
        <div class="p-6 rounded-3xl bg-gradient-to-br from-cyan-950/70 via-slate-900 to-slate-950 border border-cyan-500/30 shadow-xl relative overflow-hidden group">
          <div class="flex items-center justify-between mb-4">
            <span class="px-3 py-1 rounded-full text-[11px] font-extrabold uppercase tracking-wider bg-cyan-500/20 text-cyan-400 border border-cyan-500/30">
              🤖 BOT EA ĐỘC QUYỀN
            </span>
            <span class="text-xs text-cyan-400 font-bold">Max DD &lt; 10%</span>
          </div>

          <h3 class="text-xl font-extrabold text-white mb-2 group-hover:text-cyan-300 transition-colors">
            Bot EA Trading Vàng (MT5) No Pain No Gain
          </h3>
          <p class="text-xs text-slate-300 leading-relaxed mb-5">
            Thuật toán định lượng săn thanh khoản SMC, 100% lệnh có Stop Loss cứng, kiểm toán lịch sử Myfxbook minh bạch. Tặng 1 tuần chạy thử!
          </p>

          <div class="space-y-2.5">
            <!-- Nút nhận bot chạy thử -->
            <a
              href="https://t.me/willrichus"
              target="_blank"
              class="w-full py-3.5 px-4 rounded-xl bg-gradient-to-r from-cyan-500 to-blue-500 hover:from-cyan-400 hover:to-blue-400 text-slate-950 font-extrabold text-xs uppercase tracking-wider transition-all flex items-center justify-center gap-2 shadow-lg shadow-cyan-950/50"
            >
              <i class="fa-solid fa-gift text-sm"></i>
              <span>NHẬN BOT CHẠY THỬ 1 TUẦN (@willrichus)</span>
            </a>

            <!-- Link xem lịch sử Myfxbook trên website -->
            <a
              href="/bot-ea-trading"
              class="w-full py-2.5 px-4 rounded-xl bg-slate-800/80 hover:bg-slate-700 text-slate-200 border border-slate-700 font-bold text-xs text-center transition-colors block"
            >
              Xem Chi Tiết & Lịch Sử Myfxbook →
            </a>
          </div>
        </div>

        <!-- BANNER 3: VIP TRADING SIGNALS -->
        <div class="p-6 rounded-3xl bg-gradient-to-br from-amber-950/70 via-slate-900 to-slate-950 border border-amber-500/30 shadow-xl relative overflow-hidden group">
          <div class="flex items-center justify-between mb-4">
            <span class="px-3 py-1 rounded-full text-[11px] font-extrabold uppercase tracking-wider bg-amber-500/20 text-amber-400 border border-amber-500/30">
              👑 TÍN HIỆU SMC VIP
            </span>
            <span class="text-xs text-amber-400 font-bold">Winrate 78.5%</span>
          </div>

          <h3 class="text-xl font-extrabold text-white mb-2 group-hover:text-amber-300 transition-colors">
            Kênh Tín Hiệu VIP Vàng & Crypto
          </h3>
          <p class="text-xs text-slate-300 leading-relaxed mb-5">
            Theo chân dòng tiền thông minh SMC với R:R trung bình 1:2.8+. Đồng bộ Webhook MT5 Realtime. Miễn phí trọn đời qua sàn đối tác.
          </p>

          <div class="space-y-2.5">
            <!-- Nút vào VIP -->
            <a
              href="/trading-signal-vip#vip-flow"
              class="w-full py-3.5 px-4 rounded-xl bg-gradient-to-r from-amber-500 to-yellow-500 hover:from-amber-400 hover:to-yellow-400 text-slate-950 font-extrabold text-xs uppercase tracking-wider transition-all flex items-center justify-center gap-2 shadow-lg shadow-amber-950/50"
            >
              <i class="fa-solid fa-crown text-sm"></i>
              <span>KÍCH HOẠT VIP QUA SÀN ĐỐI TÁC</span>
            </a>

            <!-- Nút Telegram Free -->
            <a
              href="https://t.me/channelmcg"
              target="_blank"
              class="w-full py-2.5 px-4 rounded-xl bg-slate-800/80 hover:bg-slate-700 text-slate-200 border border-slate-700 font-bold text-xs text-center transition-colors block"
            >
              Tham Gia Kênh Telegram Free (@channelmcg) →
            </a>
          </div>
        </div>

      </aside>

    </div>
  </section>

  <!-- ========================================================
       PHẦN 2: CÁC KHỐI CHUYÊN MỤC BÀI VIẾT (VỚI ẢNH THUMBNAIL 16:9)
       ======================================================== -->

  <!-- CHUYÊN MỤC 1: Thị Trường và AI 247 -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-12 border-t border-slate-800/80">
    <div class="flex items-center justify-between mb-8 pb-3 border-b border-slate-800">
      <div>
        <span class="text-xs font-bold uppercase tracking-wider text-blue-400">Cập Nhật 24/7</span>
        <h2 class="text-xl sm:text-2xl font-extrabold text-white flex items-center gap-2">
          <span>📰 Thị Trường và AI 247</span>
        </h2>
      </div>
      <a href="/thi-truong-va-ai-247" class="text-xs sm:text-sm font-semibold text-slate-400 hover:text-emerald-400 transition-colors">
        Xem tất cả →
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {newsArticles.map((art) => (
        <article class="bg-slate-900/70 border border-slate-800 rounded-2xl overflow-hidden hover:border-slate-700 transition-all flex flex-col justify-between group shadow-lg">
          <div>
            <!-- Ảnh 16:9 -->
            <a href={`/p/${art.slug}`} class="block aspect-video overflow-hidden bg-slate-950 border-b border-slate-800">
              <img
                src={art.featuredImage}
                alt={art.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                loading="lazy"
              />
            </a>
            <div class="p-5">
              <div class="flex items-center justify-between text-[11px] text-slate-400 mb-2">
                <span class="text-blue-400 font-semibold">{art.category}</span>
                <span>{art.date}</span>
              </div>
              <h3 class="text-base font-bold text-white group-hover:text-emerald-400 transition-colors mb-2.5 line-clamp-2 leading-snug">
                <a href={`/p/${art.slug}`}>{art.title}</a>
              </h3>
              <p class="text-xs text-slate-400 line-clamp-3 leading-relaxed">
                {art.summary}
              </p>
            </div>
          </div>
          <div class="px-5 pb-5 pt-2 border-t border-slate-800/60">
            <a href={`/p/${art.slug}`} class="text-xs font-bold text-emerald-400 hover:underline inline-flex items-center gap-1">
              Đọc bài viết →
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- CHUYÊN MỤC 2: Hướng Dẫn Về AI & MMO -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-12 bg-slate-900/30 rounded-3xl my-6 border border-slate-800/60">
    <div class="flex items-center justify-between mb-8 pb-3 border-b border-slate-800">
      <div>
        <span class="text-xs font-bold uppercase tracking-wider text-emerald-400">Thực Chiến MMO</span>
        <h2 class="text-xl sm:text-2xl font-extrabold text-white flex items-center gap-2">
          <span>💡 Hướng Dẫn Về AI & Hạ Tầng MMO</span>
        </h2>
      </div>
      <a href="/huong-dan-ve-ai" class="text-xs sm:text-sm font-semibold text-slate-400 hover:text-emerald-400 transition-colors">
        Xem tất cả →
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {guideArticles.map((art) => (
        <article class="bg-slate-900/70 border border-slate-800 rounded-2xl overflow-hidden hover:border-slate-700 transition-all flex flex-col justify-between group shadow-lg">
          <div>
            <!-- Ảnh 16:9 -->
            <a href={`/p/${art.slug}`} class="block aspect-video overflow-hidden bg-slate-950 border-b border-slate-800">
              <img
                src={art.featuredImage}
                alt={art.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                loading="lazy"
              />
            </a>
            <div class="p-5">
              <div class="flex items-center justify-between text-[11px] text-slate-400 mb-2">
                <span class="text-emerald-400 font-semibold">{art.category}</span>
                <span>{art.date}</span>
              </div>
              <h3 class="text-base font-bold text-white group-hover:text-emerald-400 transition-colors mb-2.5 line-clamp-2 leading-snug">
                <a href={`/p/${art.slug}`}>{art.title}</a>
              </h3>
              <p class="text-xs text-slate-400 line-clamp-3 leading-relaxed">
                {art.summary}
              </p>
            </div>
          </div>
          <div class="px-5 pb-5 pt-2 border-t border-slate-800/60">
            <a href={`/p/${art.slug}`} class="text-xs font-bold text-emerald-400 hover:underline inline-flex items-center gap-1">
              Đọc chi tiết →
            </a>
          </div>
        </article>
      ))}
    </div>

    <!-- Lead Magnet Banner Nhỏ -->
    <div class="mt-8 p-6 rounded-2xl bg-gradient-to-r from-emerald-950/80 via-slate-900 to-slate-950 border border-emerald-500/30 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-4">
        <span class="w-12 h-12 rounded-xl bg-emerald-500/10 text-emerald-400 flex items-center justify-center text-2xl border border-emerald-500/20">
          🎁
        </span>
        <div>
          <h4 class="text-base font-bold text-white">Quà Tặng Lead Magnet: Key GPM-Login & Gói Data Skill AI</h4>
          <p class="text-xs text-slate-400">Trang bị trọn bộ giải pháp nuôi tài khoản không lo checkpoint cho thành viên cộng đồng.</p>
        </div>
      </div>
      <a href="/kho-ai-ha-tang-mmo" class="px-5 py-2.5 bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold text-xs uppercase tracking-wider rounded-xl transition-colors whitespace-nowrap shadow-lg">
        Nhận Quà Tại Kho MMO
      </a>
    </div>
  </section>

  <!-- CHUYÊN MỤC 3: Phân Tích Crypto và Gold -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-12 border-t border-slate-800/80">
    <div class="flex items-center justify-between mb-8 pb-3 border-b border-slate-800">
      <div>
        <span class="text-xs font-bold uppercase tracking-wider text-amber-400">Kỹ Thuật SMC</span>
        <h2 class="text-xl sm:text-2xl font-extrabold text-white flex items-center gap-2">
          <span>📊 Phân Tích Crypto và Gold</span>
        </h2>
      </div>
      <a href="/phan-tich-crypto-va-gold" class="text-xs sm:text-sm font-semibold text-slate-400 hover:text-emerald-400 transition-colors">
        Xem tất cả →
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {analysisArticles.map((art) => (
        <article class="bg-slate-900/70 border border-slate-800 rounded-2xl overflow-hidden hover:border-slate-700 transition-all flex flex-col justify-between group shadow-lg">
          <div>
            <!-- Ảnh 16:9 -->
            <a href={`/p/${art.slug}`} class="block aspect-video overflow-hidden bg-slate-950 border-b border-slate-800">
              <img
                src={art.featuredImage}
                alt={art.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                loading="lazy"
              />
            </a>
            <div class="p-5">
              <div class="flex items-center justify-between text-[11px] text-slate-400 mb-2">
                <span class="text-amber-400 font-semibold">{art.category}</span>
                <span>{art.date}</span>
              </div>
              <h3 class="text-base font-bold text-white group-hover:text-emerald-400 transition-colors mb-2.5 line-clamp-2 leading-snug">
                <a href={`/p/${art.slug}`}>{art.title}</a>
              </h3>
              <p class="text-xs text-slate-400 line-clamp-3 leading-relaxed">
                {art.summary}
              </p>
            </div>
          </div>
          <div class="px-5 pb-5 pt-2 border-t border-slate-800/60">
            <a href={`/p/${art.slug}`} class="text-xs font-bold text-emerald-400 hover:underline inline-flex items-center gap-1">
              Đọc phân tích →
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>

</Layout>
