---
import Layout from '../layouts/Layout.astro';
import { getPublishedArticles } from '../lib/notion.js';

const category = 'Phân Tích Crypto và Gold';
const articles = await getPublishedArticles(category);
---

<Layout title="Phân Tích Crypto và Gold | Tin Tức NFT" activeNav="Phân Tích Crypto và Gold" description="Phân tích kỹ thuật Vàng XAUUSD, Bitcoin và Crypto theo phương pháp Smart Money Concept (SMC), Order Block và quét thanh khoản.">

  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-12">
    <!-- Header Chuyên Mục -->
    <div class="mb-10 text-center max-w-3xl mx-auto">
      <span class="text-xs font-bold uppercase tracking-wider text-amber-400 bg-amber-950/60 border border-amber-800/60 px-3 py-1 rounded-full">Kỹ Thuật Chuyên Sâu</span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-white mt-4 mb-3">Phân Tích Crypto và Gold</h1>
      <p class="text-sm sm:text-base text-slate-400">
        Đọc hiểu bản đồ thanh khoản của cá mập tài chính: Xác định vùng Order Block then chốt, bẫy giá Inducement và điểm vào lệnh tối ưu.
      </p>
    </div>

    <!-- BANNER QUẢNG CÁO NỔI BẬT: COMBO BOT EA MT5 & TÍN HIỆU SIGNAL VIP -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-12">
      <!-- THẺ 1: BOT EA MT5 (NO PAIN NO GAIN) -->
      <div class="banner-card-cyan p-6 sm:p-7 rounded-3xl relative overflow-hidden group flex flex-col justify-between transition-all duration-300 hover:-translate-y-1">
        <div class="absolute -right-10 -bottom-10 w-52 h-52 bg-cyan-500/10 rounded-full blur-3xl group-hover:bg-cyan-500/20 transition-all duration-700 pointer-events-none"></div>

        <div>
          <div class="flex items-center justify-between mb-4">
            <span class="banner-badge-cyan px-3 py-1 rounded-full text-xs font-extrabold uppercase tracking-wider inline-flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-cyan-500 animate-ping"></span>
              🤖 BOT EA MT5 TỰ ĐỘNG
            </span>
            <span class="text-xs font-extrabold text-cyan-600 dark:text-cyan-400">Myfxbook +1,114.7%</span>
          </div>

          <h2 class="banner-title text-xl sm:text-2xl font-extrabold mb-2 leading-snug">
            Bot EA No Pain No Gain: Giao Dịch Vàng XAUUSD 24/5
          </h2>
          <p class="banner-desc text-xs sm:text-sm leading-relaxed mb-6">
            Thuật toán săn thanh khoản tự động, quản trị vốn chuẩn quỹ định lượng, không gồng lỗ thả nổi. Đã chạy thực chiến trên MT5 sàn PU Prime.
          </p>

          <div class="banner-meta-box grid grid-cols-2 gap-3 mb-6 p-3.5 rounded-xl text-xs">
            <div>
              <div class="banner-meta-box-label text-[11px]">Tài sản chuyên sâu</div>
              <div class="banner-meta-box-val font-bold">Vàng XAUUSD (M15)</div>
            </div>
            <div>
              <div class="banner-meta-box-label text-[11px]">Đặc quyền độc quyền</div>
              <div class="font-extrabold text-cyan-600 dark:text-cyan-400">Tặng 1 tuần test free</div>
            </div>
          </div>
        </div>

        <div class="space-y-2.5">
          <a
            href="https://t.me/willrichus"
            target="_blank"
            class="banner-cta-primary-cyan w-full py-3.5 px-4 rounded-xl font-extrabold text-xs uppercase tracking-wider transition-all flex items-center justify-center gap-2 transform hover:scale-[1.02] active:scale-[0.98]"
          >
            <i class="fa-solid fa-robot"></i>
            <span>NHẬN TEST BOT EA 1 TUẦN MIỄN PHÍ</span>
          </a>

          <a
            href="/bot-ea-trading"
            class="banner-cta-secondary w-full py-2.5 px-4 rounded-xl text-xs text-center transition-all block font-bold"
          >
            Xem Chi Tiết & Lịch Sử Myfxbook →
          </a>
        </div>
      </div>

      <!-- THẺ 2: KÊNH TÍN HIỆU SIGNAL VIP -->
      <div class="banner-card-amber p-6 sm:p-7 rounded-3xl relative overflow-hidden group flex flex-col justify-between transition-all duration-300 hover:-translate-y-1">
        <div class="absolute -right-10 -bottom-10 w-52 h-52 bg-amber-500/10 rounded-full blur-3xl group-hover:bg-amber-500/20 transition-all duration-700 pointer-events-none"></div>

        <div>
          <div class="flex items-center justify-between mb-4">
            <span class="banner-badge-amber px-3 py-1 rounded-full text-xs font-extrabold uppercase tracking-wider inline-flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-amber-500 animate-ping"></span>
              👑 TÍN HIỆU SMC VIP
            </span>
            <span class="text-xs font-extrabold text-amber-600 dark:text-amber-400">Winrate 78.5%</span>
          </div>

          <h2 class="banner-title text-xl sm:text-2xl font-extrabold mb-2 leading-snug">
            Kênh Tín Hiệu VIP Vàng & Crypto SMC
          </h2>
          <p class="banner-desc text-xs sm:text-sm leading-relaxed mb-6">
            Bắt trọn các nhịp quét thanh khoản (Liquidity Sweep) và khối Order Block tổ chức. R:R trung bình 1:2.8+. Đồng bộ MT5 Webhook tức thời.
          </p>

          <div class="banner-meta-box grid grid-cols-2 gap-3 mb-6 p-3.5 rounded-xl text-xs">
            <div>
              <div class="banner-meta-box-label text-[11px]">Tần suất lệnh</div>
              <div class="banner-meta-box-val font-bold">3-5 lệnh/ngày chọn lọc</div>
            </div>
            <div>
              <div class="banner-meta-box-label text-[11px]">Chi phí tham gia</div>
              <div class="font-extrabold text-amber-600 dark:text-amber-400">Miễn phí qua sàn đối tác</div>
            </div>
          </div>
        </div>

        <div class="space-y-2.5">
          <a
            href="/trading-signal-vip#vip-flow"
            class="banner-cta-primary-amber w-full py-3.5 px-4 rounded-xl font-extrabold text-xs uppercase tracking-wider transition-all flex items-center justify-center gap-2 transform hover:scale-[1.02] active:scale-[0.98]"
          >
            <i class="fa-solid fa-crown"></i>
            <span>KÍCH HOẠT VIP QUA SÀN ĐỐI TÁC</span>
          </a>

          <a
            href="https://t.me/channelmcg"
            target="_blank"
            class="banner-cta-secondary w-full py-2.5 px-4 rounded-xl text-xs text-center transition-all block font-bold"
          >
            Tham Gia Kênh Telegram Free (@channelmcg) →
          </a>
        </div>
      </div>
    </div>

    <!-- DANH SÁCH BÀI VIẾT (CÓ ẢNH THUMBNAIL 16:9 CHUẨN TRANG HOME) -->
    {articles.length === 0 ? (
      <div class="text-center py-16 bg-slate-900/50 rounded-2xl border border-slate-800">
        <p class="text-slate-400">Chưa có bài viết nào trong chuyên mục này. Hãy thêm bài mới trên Notion!</p>
      </div>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {articles.map((art) => (
          <article class="bg-slate-900/80 border border-slate-800 rounded-2xl overflow-hidden hover:border-amber-500/50 transition-all flex flex-col justify-between group shadow-xl">
            <div>
              <!-- ẢNH THUMBNAIL 16:9 -->
              <a href={`/p/${art.slug}`} class="block aspect-video overflow-hidden bg-slate-950 border-b border-slate-800">
                <img
                  src={art.featuredImage}
                  alt={art.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                  loading="lazy"
                />
              </a>

              <div class="p-6">
                <div class="flex items-center justify-between text-xs text-slate-400 mb-3">
                  <span class="text-amber-400 font-semibold">{art.category}</span>
                  <span>{art.date}</span>
                </div>
                <h2 class="text-lg font-bold text-white hover:text-amber-300 transition-colors mb-3 leading-snug">
                  <a href={`/p/${art.slug}`}>{art.title}</a>
                </h2>
                <p class="text-xs sm:text-sm text-slate-400 line-clamp-3 mb-4 leading-relaxed">
                  {art.summary}
                </p>
              </div>
            </div>

            <div class="px-6 pb-6 pt-2 border-t border-slate-800/60">
              <a href={`/p/${art.slug}`} class="text-xs font-semibold text-amber-400 hover:text-amber-300 flex items-center gap-1.5">
                Đọc toàn bộ bài viết →
              </a>
            </div>
          </article>
        ))}
      </div>
    )}
  </section>

</Layout>
