---
import Layout from '../../layouts/Layout.astro';
import { getPublishedArticles, getArticleBySlug, renderBlockToHtml } from '../../lib/notion.js';

export async function getStaticPaths() {
  const articles = await getPublishedArticles();
  return articles.map((art) => ({
    params: { slug: art.slug },
    props: { articleSummary: art }
  }));
}

const { slug } = Astro.params;
const article = await getArticleBySlug(slug);

if (!article) {
  return Astro.redirect('/404');
}
---

<Layout
  title={`${article.title} | Tin Tức NFT`}
  description={article.summary || article.title}
  image={article.featuredImage || "/banner.jpg"}
  activeNav={article.category}
>
  <article class="max-w-4xl mx-auto px-4 sm:px-6 py-12">
    <!-- Breadcrumb -->
    <nav class="flex items-center space-x-2 text-xs text-slate-400 mb-6">
      <a href="/" class="hover:text-emerald-400">Trang chủ</a>
      <span>/</span>
      <span class="text-emerald-400 font-medium">{article.category}</span>
    </nav>

    <!-- Header -->
    <header class="mb-10 pb-8 border-b border-slate-800">
      <div class="inline-block px-3 py-1 rounded-full bg-slate-800 text-emerald-400 text-xs font-semibold uppercase tracking-wider mb-4">
        {article.category}
      </div>
      <h1 class="text-2xl sm:text-4xl font-extrabold text-white leading-tight mb-4">
        {article.title}
      </h1>
      <div class="flex items-center text-xs text-slate-400 space-x-4">
        <span>📅 Ngày đăng: {article.date || "Hôm nay"}</span>
        <span>•</span>
        <span>⏱️ Thời gian đọc: 5 phút</span>
        <span>•</span>
        <span class="text-emerald-400">Tác giả: Smart Trader VIP Team</span>
      </div>
      {article.summary && (
        <div class="mt-6 p-4 rounded-xl bg-slate-900 border-l-4 border-emerald-500 text-slate-300 text-sm leading-relaxed italic">
          {article.summary}
        </div>
      )}
    </header>

    <!-- Main Content Blocks from Notion -->
    <div class="prose prose-invert max-w-none text-slate-300 text-base leading-relaxed">
      {article.blocks.map((block) => (
        <Fragment set:html={renderBlockToHtml(block)} />
      ))}
    </div>

    <!-- Dynamic Category Call-To-Action Box -->
    <div class="mt-16 pt-8 border-t border-slate-800">
      {article.category === 'Hướng Dẫn Về AI' ? (
        <div class="p-6 rounded-2xl bg-gradient-to-r from-emerald-950/60 to-slate-900 border border-emerald-800/80 flex flex-col sm:flex-row items-center justify-between gap-6">
          <div>
            <span class="text-xs font-bold text-emerald-400 uppercase tracking-wider">HẠ TẦNG THỰC CHIẾN</span>
            <h3 class="text-lg font-bold text-white mt-1">🎁 Nhận Ngay Key GPM-Login & Gói Data Skill AI</h3>
            <p class="text-xs text-slate-400 mt-1">Hỗ trợ thiết lập VPS, Proxy IPv4 tĩnh để tự động hóa nuôi nick an toàn.</p>
          </div>
          <a href="/kho-ai-ha-tang-mmo" class="px-5 py-2.5 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold text-xs uppercase tracking-wider transition-colors whitespace-nowrap shadow-lg">
            Vào Kho MMO →
          </a>
        </div>
      ) : article.category === 'Phân Tích Crypto và Gold' ? (
        <div class="p-6 rounded-2xl bg-gradient-to-r from-amber-950/60 to-slate-900 border border-amber-800/80 flex flex-col sm:flex-row items-center justify-between gap-6">
          <div>
            <span class="text-xs font-bold text-amber-400 uppercase tracking-wider">TỰ ĐỘNG HÓA GIAO DỊCH</span>
            <h3 class="text-lg font-bold text-white mt-1">📊 Tham Gia Kênh Trading Signal VIP & Trải Nghiệm Bot MT5</h3>
            <p class="text-xs text-slate-400 mt-1">Đồng bộ tín hiệu SMC realtime và chạy thử Bot EA No Pain No Gain miễn phí 1 tuần.</p>
          </div>
          <div class="flex gap-2">
            <a href="/trading-signal-vip" class="px-4 py-2.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-xs uppercase tracking-wider transition-colors whitespace-nowrap">
              Xem Signal VIP
            </a>
            <a href="/bot-ea-trading" class="px-4 py-2.5 rounded-xl bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-bold text-xs uppercase tracking-wider transition-colors whitespace-nowrap">
              Xem Bot EA
            </a>
          </div>
        </div>
      ) : (
        <div class="p-6 rounded-2xl bg-gradient-to-r from-blue-950/60 to-slate-900 border border-blue-800/80 flex flex-col sm:flex-row items-center justify-between gap-6">
          <div>
            <span class="text-xs font-bold text-blue-400 uppercase tracking-wider">CẬP NHẬT 24/7</span>
            <h3 class="text-lg font-bold text-white mt-1">✈️ Tham Gia Kênh Telegram Để Nhận Tin Sớm Nhất</h3>
            <p class="text-xs text-slate-400 mt-1">Không bỏ lỡ bất kỳ biến động vĩ mô và cơ hội thị trường nào.</p>
          </div>
          <a href="https://t.me/smarttradervip" target="_blank" class="px-5 py-2.5 rounded-xl bg-blue-500 hover:bg-blue-400 text-white font-bold text-xs uppercase tracking-wider transition-colors whitespace-nowrap">
            Vào Kênh Telegram →
          </a>
        </div>
      )}
    </div>

    <!-- Navigation Back -->
    <div class="mt-10 flex justify-between items-center text-xs text-slate-400">
      <a href="/" class="hover:text-emerald-400">← Về trang chủ</a>
      <a href="#" onclick="window.scrollTo({top: 0, behavior: 'smooth'}); return false;" class="hover:text-emerald-400">Lên đầu trang ↑</a>
    </div>
  </article>
</Layout>
